{
  "name": "odd-hr",
  "productName": "ODD HR",
  "version": "0.4.0",
  "description": "ODD HR: 팀 AX 앱 (아침상, 알림, 작업, 할 일, 메시지, 드라이브, 미팅·회의록, 목표, 팀원, 카톡 에이전트)",
  "author": "ODD",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.js",
  "scripts": {
    "ui": "python3 tools/build_ui.py",
    "vendor": "node tools/vendor.js",
    "start": "npm run vendor && electron .",
    "test:server": "node server/test/run.js",
    "test:e2e": "node test/e2e.js",
    "dist:win": "npm run vendor && electron-builder --win --x64 --publish never",
    "dist:mac": "npm run vendor && electron-builder --mac --universal --publish never",
    "web": "npm run vendor && node tools/build_web.js",
    "verify": "node tools/verify_release.js",
    "test:updater": "node test/updater.test.js"
  },
  "devDependencies": {
    "@supabase/supabase-js": "2.45.4",
    "electron": "31.7.7",
    "electron-builder": "24.13.3",
    "@electric-sql/pglite": "0.2.12",
    "playwright": "1.48.2",
    "@electron/asar": "3.4.1"
  },
  "build": {
    "appId": "kr.oddhr.app",
    "productName": "ODD HR",
    "copyright": "ODD",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "updater.js",
      "app/**",
      "build/icon.png",
      "build/tray.png",
      "build/trayTemplate*.png",
      "app-config.json",
      "package.json",
      "!app/**/*.map"
    ],
    "extraResources": [
      {
        "from": "agent-dist",
        "to": "agent",
        "filter": [
          "odd-hr-agent.exe",
          "odd-hr-agent"
        ]
      }
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "ODD-HR-${version}-win.${ext}",
      "legalTrademarks": "ODD"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ODD HR",
      "uninstallDisplayName": "ODD HR",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "language": "1042",
      "artifactName": "ODD-HR-Setup-${version}.exe"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.productivity",
      "identity": null,
      "artifactName": "ODD-HR-${version}-mac.dmg",
      "minimumSystemVersion": "11.0",
      "extendInfo": {
        "LSApplicationCategoryType": "public.app-category.productivity",
        "NSAppleEventsUsageDescription": "카톡 점검(Mac)에서 카카오톡 창을 읽을 때 씁니다."
      }
    },
    "dmg": {
      "title": "ODD HR"
    },
    "publish": null
  }
}
